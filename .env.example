# ─────────────────────────────────────────────────────────────────────────────
#  Arah! · configuration
#  Copie ce fichier en « .env » à la racine du projet, puis adapte les valeurs.
#  Sans clé d'IA, la plateforme fonctionne entièrement en « mode règles ».
# ─────────────────────────────────────────────────────────────────────────────

# --- Application -------------------------------------------------------------
ENVIRONMENT=development
# Obligatoire en production (32 caractères minimum). Génère-en une avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
# Adresse publique du site (utilisée dans les e-mails et les redirections)
PUBLIC_URL=http://localhost:5173
# Adresse publique de l'API. En local, le front relaie /api : garde la même valeur que PUBLIC_URL.
API_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Adresses e-mail qui deviennent administratrices à l'inscription (séparées par des virgules)
ADMIN_EMAILS=
TIMEZONE=Africa/Dakar
LOG_LEVEL=INFO

# --- Base de données ---------------------------------------------------------
POSTGRES_USER=arah
POSTGRES_PASSWORD=arah
POSTGRES_DB=arah
# Avec Docker Compose, l'hôte est « db ». En local sans Docker : localhost.
DATABASE_URL=postgresql+asyncpg://arah:arah@localhost:5432/arah

# --- Agent -------------------------------------------------------------------
SCHEDULER_ENABLED=true
# Veille complète chaque matin à 6 h, rappels à 8 h (heure de TIMEZONE)
AGENT_CRON=0 6 * * *
REMINDERS_CRON=0 8 * * *
# Offres fictives pour tester en local. À mettre à false en production.
DEMO_DATA=true
# Score minimum pour qu'une offre entre dans le radar d'un utilisateur
MATCH_MIN_SCORE=35
# Nombre d'offres affinées par l'IA par utilisateur et par veille
LLM_RERANK_PER_USER=5
# Nombre maximum d'offres résumées par l'IA à chaque veille
LLM_ENRICH_PER_RUN=60

# --- Modèles d'IA ------------------------------------------------------------
# Fournisseur : openrouter | anthropic | openai | google | none
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Modèles (laisse vide pour les valeurs par défaut du fournisseur, voir README)
#   rapide : tri, fiches, scores · avancé : brouillons de réponse
LLM_MODEL_FAST=
LLM_MODEL_SMART=
# Plafond de dépenses IA sur 24 h (en dollars) et utilisations par utilisateur et par jour
LLM_DAILY_BUDGET_USD=2
LLM_USER_DAILY_CALLS=20
# Prix par million de jetons, pour estimer le coût quand le fournisseur ne le renvoie pas
LLM_PRICE_FAST_IN=1
LLM_PRICE_FAST_OUT=5
LLM_PRICE_SMART_IN=3
LLM_PRICE_SMART_OUT=15
USD_TO_XOF=600

# --- E-mail ------------------------------------------------------------------
# console : les e-mails s'affichent dans les journaux de l'API · smtp : envoi réel
EMAIL_BACKEND=console
# Avec Docker Compose en local, laisse SMTP_HOST vide : Mailpit capture tous les e-mails (http://localhost:8025).
# Pour de vrais envois, renseigne ton fournisseur, par exemple :
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_SECURITY=starttls
#   SMTP_HOST=smtp.gmail.com        SMTP_PORT=587  SMTP_SECURITY=starttls  (mot de passe d'application Google)
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# starttls (port 587) | ssl (port 465) | none (Mailpit)
SMTP_SECURITY=none
EMAIL_FROM=Arah! <alertes@arah.local>
EMAIL_REPLY_TO=

# --- WhatsApp (désactivé tant que les dons ne couvrent pas les frais Meta) ---
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_DIGEST=arah_digest
WHATSAPP_TEMPLATE_REMINDER=arah_rappel
WHATSAPP_TEMPLATE_LANG=fr

# --- Connexion avec Google (facultatif) --------------------------------------
# URI de redirection à déclarer dans Google Cloud : {API_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Dons --------------------------------------------------------------------
# PayTech (Wave, Orange Money, carte). URL de notification : {API_URL}/api/donations/ipn
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=test
DONATION_WAVE_NUMBER=
DONATION_ORANGE_MONEY_NUMBER=
DONATION_MONTHLY_GOAL_XOF=30000
GITHUB_URL=https://github.com/
CONTACT_EMAIL=contact@example.com

# --- Production uniquement (docker-compose.prod.yml) -------------------------
DOMAIN=arah.example.com
WEB_CONCURRENCY=2
